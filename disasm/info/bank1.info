RANGE { START $AB06; END $AB11; TYPE ByteTable; };
# NEWBITS.ROU code (addsparkletotreasures, redefinewater)
RANGE { START $AB12; END $ABD8; TYPE Code; };
# NEWBITS secrettable + secret data + EXPLODE dispatch tables
RANGE { START $ABD9; END $AD11; TYPE ByteTable; };

# EXPLODE.ROU code
